        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all()\n  .map(i => i.json)\n  .filter(j => j && Object.keys(j).length > 0 && j.id_tutoria);\n\nconst manana = $now.setZone('America/Guatemala').plus({ days: 1 }).toFormat('yyyy-MM-dd');\nconst estadosValidos = ['asignada', 'confirmada'];\n\nconst salida = [];\nfor (const r of rows) {\n  const fecha = (r.fecha || '').toString().trim();\n  const estado = (r.estado || '').toString().trim().toLowerCase();\n  let fechaNorm = fecha;\n  const d = DateTime.fromISO(fecha, { zone: 'America/Guatemala' });\n  if (d.isValid) fechaNorm = d.toFormat('yyyy-MM-dd');\n\n  if (fechaNorm === manana && estadosValidos.includes(estado)) {\n    salida.push({\n      json: {\n        id_tutoria: r.id_tutoria,\n        id_estudiante: r.id_estudiante,\n        id_tutor: r.id_tutor,\n        materia: r.materia,\n        fecha: fechaNorm,\n        hora: r.hora,\n        estado: r.estado,\n        mensaje: '⏰ Recordatorio de tutoría\\n\\n'\n          + 'Materia: ' + r.materia + '\\n'\n          + 'Fecha: ' + fechaNorm + '\\n'\n          + 'Hora: ' + (r.hora || '') + '\\n'\n          + 'Tutor: ' + (r.id_tutor || '') + '\\n\\n'\n          + '¡No olvides asistir!',\n      },\n    });\n  }\n}\n\nreturn salida;"
      },
