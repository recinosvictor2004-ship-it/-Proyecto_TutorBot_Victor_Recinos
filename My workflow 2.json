    {
      "parameters": {
        "jsCode": "const rows = $input.all()\n  .map(i => i.json)\n  .filter(j => j && Object.keys(j).length > 0 && (j.id_tutoria || j.materia || j.estado));\n\nconst hoy = $now.setZone('America/Guatemala');\nconst desde = hoy.minus({ days: 7 });\n\nfunction parseFecha(f) {\n  if (!f) return null;\n  const d = DateTime.fromISO(String(f), { zone: 'America/Guatemala' });\n  return d.isValid ? d : null;\n}\n\nconst delPeriodo = rows.filter(r => {\n  const d = parseFecha(r.fecha);\n  return d && d >= desde.startOf('day') && d <= hoy.endOf('day');\n});\n\nconst base = delPeriodo.length > 0 ? delPeriodo : rows;\n\nconst porEstado = {};\nconst porMateria = {};\nfor (const r of base) {\n  const estado = (r.estado || 'Sin estado').toString().trim();\n  const materia = (r.materia || 'Sin materia').toString().trim();\n  porEstado[estado] = (porEstado[estado] || 0) + 1;\n  porMateria[materia] = (porMateria[materia] || 0) + 1;\n}\n\nconst total = base.length;\nconst rango = desde.toFormat('yyyy-MM-dd') + ' a ' + hoy.toFormat('yyyy-MM-dd');\n\nlet mensaje;\nif (total === 0) {\n  mensaje = '📊 Reporte TutorBot (' + rango + ')\\n\\nSin actividad de tutorías en el periodo.';\n} else {\n  const estadoLines = Object.keys(porEstado).map(k => '  • ' + k + ': ' + porEstado[k]).join('\\n');\n  const materiaLines = Object.keys(porMateria).map(k => '  • ' + k + ': ' + porMateria[k]).join('\\n');\n  mensaje = '📊 Reporte TutorBot (' + rango + ')\\n\\n'\n    + 'Total de tutorías: ' + total + '\\n\\n'\n    + 'Por estado:\\n' + estadoLines + '\\n\\n'\n    + 'Por materia:\\n' + materiaLines;\n}\n\nreturn [{ json: { total, porEstado, porMateria, rango, mensaje } }];"
      },
